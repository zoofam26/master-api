# master-api configuration — copy to `.env` and adjust.
# Every variable is optional; the defaults below work out of the box.

# ---------------------------------------------------------------- server -----
# Bind address of the unified server.
APP_HOST=0.0.0.0
APP_PORT=8080

# CORS allowed origins (comma-separated list, or `*`).
CORS_ORIGIN=*

# Client-facing rate limit, requests per minute per IP (0 disables).
RATE_LIMIT_PER_MINUTE=600

# ---------------------------------------------------------------- logs -------
# `info` (default) | `debug` | `trace` — RUST_LOG filter syntax also works,
# e.g. `RUST_LOG=info,svc_youtube=debug`.
RUST_LOG=info
# Emit structured JSON logs instead of human-readable ones (recommended in prod).
JSON_LOGS=false

# ---------------------------------------------------------------- upstreams --
# Per-upstream-request timeout.
UPSTREAM_TIMEOUT_SECONDS=15
# Extra attempts after the first failure for idempotent GETs.
UPSTREAM_MAX_RETRIES=1
# Base backoff step between retries (doubles with each attempt).
RETRY_BASE_DELAY_MS=200

# Base-URL overrides — point any upstream at a proxy/fixture, e.g.
# UPSTREAM_NAGER=https://date.nager.at
# UPSTREAM_OPEN_LIBRARY=https://openlibrary.org

# ---------------------------------------------------------------- caching ----
# Default TTL for upstream JSON responses (seconds).
CACHE_TTL_SECONDS=300
# Maximum cached entries per service cache.
CACHE_MAX_CAPACITY=10000
# TTL for downloaded dataset/feed snapshots: GeoNames countryInfo, GTFS bundles
# (transit), Hipo universities, Open Library country list (seconds, default 6h).
FEED_CACHE_TTL_SECONDS=21600
# Per-cache TTL overrides (seconds), cache names are the service aliases:
# CACHE_TTL_YOUTUBE=120
# CACHE_TTL_CURRENCY=900
# CACHE_TTL_WEATHER=600

# ---------------------------------------------------------------- api keys ---
# Optional. YouTube Data API v3 key — when set, Data API endpoints are served
# from googleapis.com; when absent, the keyless InnerTube engine is used.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional. Google Books API key — lifts the anonymous shared-IP quota for the
# books service.
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
